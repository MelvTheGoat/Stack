#!/usr/bin/env bash
# Keep commit messages to the conventional-commit format.
#
# This repo does not use message trailers: no Co-Authored-By, no tool footers,
# no links back to whatever editor or service produced the change. They add
# noise to `git log` and they date badly. Strip them rather than relying on
# everyone remembering.
#
# git does not version .git/hooks, so this lives in the tree and `make install`
# copies it into place.
sed -i'' \
  -e '/^Co-[Aa]uthored-[Bb]y:/d' \
  -e '/^Signed-off-by:.*noreply/d' \
  -e '/[Gg]enerated with \[/d' \
  -e '/^🤖 /d' \
  -e '/^[A-Za-z-]*-Session: https\?:\/\//d' \
  "$1"
