# Reckon configuration. Copy to .env and fill in. Never commit .env.
# Test mode only. A key starting with sk_live_ is rejected at startup on purpose.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Where records go. Default is a local file, so you need no database server.
RECON_DATABASE_URL=sqlite+pysqlite:///./recon.db

# Set to 1 to skip the live verify call (used by tests and the offline demo).
RECON_OFFLINE=0

# Optional. Only needed for the last extraction layer, which reads the payment
# reports the patterns could not. Without it the system runs rules-only and
# routes those reports to a person instead.
# ANTHROPIC_API_KEY=sk-ant-...
# RECON_EXTRACTION_MODEL=claude-opus-5
