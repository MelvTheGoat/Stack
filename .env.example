# Reckon configuration. Copy to .env and fill in. Never commit .env.
# Test mode only. A key starting with sk_live_ is rejected at startup on purpose.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Your admin login. On your own books the pages stay shut until it exists.
# The password is only used the first time the account is made; after that,
# change it from the account page and this value is ignored.
RECON_ADMIN_EMAIL=
RECON_PASSWORD=

# Where records go. Left unset, it is a local file, so you need no database
# server. A host that attaches Postgres sets DATABASE_URL, which is read too;
# setting this as well would win over it, so on a host leave it unset.
# RECON_DATABASE_URL=sqlite+pysqlite:///./recon.db

# Set to 1 to show the practice data instead of your own books.
RECON_DEMO=0

# Set to 1 to skip the live verify call (used by tests and the offline demo).
RECON_OFFLINE=0

# Optional. Only needed for the last extraction layer, which reads the payment
# reports the patterns could not. Without it the system runs rules-only and
# routes those reports to a person instead.
# ANTHROPIC_API_KEY=sk-ant-...
# RECON_EXTRACTION_MODEL=claude-opus-5
